{
  "version": 2,
  "builds": [
    {
      "src": "forge/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "installCommand": "pip install -r requirements.txt",
        "buildCommand": "bash build_files.sh"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "forge/wsgi.py"
    }
  ]
}